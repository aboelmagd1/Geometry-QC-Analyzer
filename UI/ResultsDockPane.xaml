<UserControl x:Class="GeometryQCAddIn.UI.ResultsDockPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="clr-namespace:GeometryQCAddIn.UI"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="360">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GeometryQCAddIn;component/UI/ThemeResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource MainBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Panel -->
        <Border Grid.Row="0" Background="{DynamicResource SidebarHeaderBackgroundBrush}" Padding="12,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Geometry QC Results" Style="{DynamicResource DockPaneHeaderStyle}"/>
                    <TextBlock Text="{Binding MetricsText}" Style="{DynamicResource MutedTextStyle}" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource BadgeBackgroundBrush}" CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalIssuesCount, StringFormat='Issues: {0}'}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BadgeForegroundBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Target Layer Selector Card -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" Margin="6,6,6,2" Padding="10,6" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Layer:" Style="{DynamicResource BodyTextStyle}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableLayers}" SelectedItem="{Binding SelectedLayer}" DisplayMemberPath="DisplayName" Height="26" VerticalContentAlignment="Center" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}" DropDownOpened="LayerComboBox_DropDownOpened"/>
                <Button Grid.Column="2" Command="{Binding RefreshLayersCommand}" Style="{DynamicResource BlueActionButtonStyle}" ToolTip="Refresh Map Layers" Margin="6,0,0,0" Padding="8,2" Content="↻" FontSize="13" VerticalAlignment="Center" Height="26"/>
            </Grid>
        </Border>

        <!-- Progress Indicator Card -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" Margin="6,4,6,2" Padding="10,8" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Vertical">
                <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="4" Margin="0,0,0,6" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                <Grid>
                    <TextBlock Text="{Binding StatusText}" Style="{DynamicResource BodyTextStyle}" VerticalAlignment="Center"/>
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{DynamicResource BlueActionButtonStyle}" HorizontalAlignment="Right" Padding="8,2" FontSize="10"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Categorized Issue Tree View -->
        <TreeView Grid.Row="3" ItemsSource="{Binding IssueGroups}" ItemContainerStyle="{DynamicResource ThemeAwareTreeViewItemStyle}" Margin="6,4" Background="Transparent" BorderThickness="0">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Issues}">
                    <!-- Category Header -->
                    <StackPanel Orientation="Horizontal" Margin="2,4" VerticalAlignment="Center">
                        <!-- Key Symbol matching map error color -->
                        <Grid Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="{Binding TooltipText}">
                            <Border Background="{Binding SymbolBrush}" Opacity="0.22" CornerRadius="4"/>
                            <Path Data="M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v4h4v-4h2v-4H12.65zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"
                                  Fill="{Binding SymbolBrush}"
                                  Width="13" Height="13"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding CheckName}" Style="{DynamicResource SectionHeaderStyle}" Margin="0" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Count}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryAccentBrush}"/>
                        </Border>
                    </StackPanel>
                    
                    <!-- Issue Child Item Card Template -->
                    <HierarchicalDataTemplate.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="4" Padding="8,6" Margin="0,2" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Vertical" Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Oid, StringFormat='OID: {0}'}" FontWeight="Medium" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{Binding LayerName, StringFormat=' ({0})'}" Style="{DynamicResource SecondaryTextStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Style="{DynamicResource MutedTextStyle}" TextWrapping="Wrap" MaxWidth="230" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Zoom" Command="{Binding DataContext.ZoomToIssueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{DynamicResource CompactZoomButtonStyle}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </HierarchicalDataTemplate.ItemTemplate>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!-- Selected Issue Details Panel -->
        <Border Grid.Row="4" Background="{DynamicResource CardBackgroundBrush}" Margin="6,2,6,6" Padding="10" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Visibility="{Binding SelectedIssue, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Issue Details" Style="{DynamicResource SectionHeaderStyle}" Foreground="{DynamicResource SecondaryAccentBrush}" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding SelectedIssue.Description}" TextWrapping="Wrap" Style="{DynamicResource BodyTextStyle}"/>
            </StackPanel>
        </Border>

        <!-- Action Toolbar Bottom -->
        <Border Grid.Row="5" Background="{DynamicResource SidebarHeaderBackgroundBrush}" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Run QC" Command="{Binding RunQCCommand}" Style="{DynamicResource TurquoiseActionButtonStyle}" Margin="0,0,4,0" Height="30"/>
                <Button Grid.Column="1" Content="Clear Results" Command="{Binding ClearResultsCommand}" Style="{DynamicResource BlueActionButtonStyle}" Margin="4,0,0,0" Height="30"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
