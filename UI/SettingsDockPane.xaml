<UserControl x:Class="GeometryQCAddIn.UI.SettingsDockPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="360">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GeometryQCAddIn;component/UI/ThemeResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource MainBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource SidebarHeaderBackgroundBrush}" Padding="12,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="Geometry QC Settings" Style="{DynamicResource DockPaneHeaderStyle}"/>
        </Border>

        <!-- Scrollable Settings Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,10">
            <StackPanel Orientation="Vertical">
                
                <!-- General Settings Group -->
                <TextBlock Text="General Execution" Style="{DynamicResource SectionHeaderStyle}"/>
                
                <CheckBox Content="Enable Geometry QC" IsChecked="{Binding IsQCEnabled}" Margin="0,3" Foreground="{DynamicResource PrimaryTextBrush}"/>
                
                <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                    <TextBlock Text="Max Features Cap: " Style="{DynamicResource SecondaryTextStyle}" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding MaxFeaturesToProcess, UpdateSourceTrigger=PropertyChanged}" 
                             ToolTip="Maximum number of selected features processed per run (Default: 500, Min: 1)" 
                             Style="{DynamicResource ThemeAwareTextBoxStyle}" Width="70" Height="22"/>
                </StackPanel>

                <CheckBox Content="Enable for Service Layers" IsChecked="{Binding EnableForServiceLayers}" Margin="0,4,0,3" Foreground="{DynamicResource PrimaryTextBrush}"/>

                <Separator Margin="0,12" Background="{DynamicResource BorderBrush}"/>

                <!-- QC Checks & Tolerances Group -->
                <TextBlock Text="QC Checks &amp; Tolerances" Style="{DynamicResource SectionHeaderStyle}" Margin="0,0,0,8"/>

                <!-- 1. Invalid Geometry -->
                <CheckBox Content="1. Invalid Geometry" IsChecked="{Binding CheckInvalidGeometry}" Margin="0,3" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}"/>

                <!-- 2. Overlaps -->
                <CheckBox Content="2. Overlaps" IsChecked="{Binding CheckOverlaps}" Margin="0,4,0,2" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="20,0,0,4">
                    <TextBlock Text="Min Overlap Area (sq m): " Style="{DynamicResource SecondaryTextStyle}" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding OverlapMinArea, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ThemeAwareTextBoxStyle}" Width="70" Height="22"/>
                </StackPanel>

                <!-- 3. Duplicates -->
                <CheckBox Content="3. Duplicate Geometries" IsChecked="{Binding CheckDuplicates}" Margin="0,3" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}"/>

                <!-- 4. Gaps -->
                <CheckBox Content="4. Enclosed Gaps" IsChecked="{Binding CheckGaps}" Margin="0,4,0,2" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="20,0,0,4">
                    <TextBlock Text="Min Gap Area (sq m): " Style="{DynamicResource SecondaryTextStyle}" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding GapMinArea, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ThemeAwareTextBoxStyle}" Width="70" Height="22"/>
                </StackPanel>

                <!-- 5. Multi-Part -->
                <CheckBox Content="5. Multi-Part Features" IsChecked="{Binding CheckMultiPart}" Margin="0,3" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}"/>

                <!-- 6. Short Segments -->
                <CheckBox Content="6. Short Segments" IsChecked="{Binding CheckShortSegments}" Margin="0,4,0,2" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="20,0,0,4">
                    <TextBlock Text="Threshold (cm): " Style="{DynamicResource SecondaryTextStyle}" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding ShortSegmentThresholdCm, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ThemeAwareTextBoxStyle}" Width="70" Height="22"/>
                </StackPanel>

                <!-- 7. Angle Issues -->
                <CheckBox Content="7. Angle Issues" IsChecked="{Binding CheckAngleIssues}" Margin="0,4,0,2" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="20,0,0,4">
                    <TextBlock Text="Min Angle (degrees): " Style="{DynamicResource SecondaryTextStyle}" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding AngleThresholdDegrees, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ThemeAwareTextBoxStyle}" Width="70" Height="22"/>
                </StackPanel>

                <!-- 8. Snap Issues -->
                <CheckBox Content="8. Snap Issues" IsChecked="{Binding CheckSnapIssues}" Margin="0,4,0,2" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="20,0,0,4">
                    <TextBlock Text="Tolerance (cm): " Style="{DynamicResource SecondaryTextStyle}" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding SnapToleranceCm, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ThemeAwareTextBoxStyle}" Width="70" Height="22"/>
                </StackPanel>

                <!-- 9. Redundant Vertices -->
                <CheckBox Content="9. Redundant / Collinear Vertices" IsChecked="{Binding CheckRedundantVertices}" Margin="0,4,0,2" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="20,0,0,4">
                    <TextBlock Text="Angle Threshold (deg): " Style="{DynamicResource SecondaryTextStyle}" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding RedundantVertexAngleDegrees, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ThemeAwareTextBoxStyle}" Width="70" Height="22"/>
                </StackPanel>
                <StackPanel Margin="20,2,0,4">
                    <CheckBox Content="Flag Arc–Line Tangent Junctions" IsChecked="{Binding FlagArcLineJunctions}" 
                              ToolTip="When enabled, warns about vertices where a true curve meets a straight line with a near-tangent (collinear) angle." 
                              Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,2"/>
                    <StackPanel Orientation="Horizontal" Margin="16,2,0,2" IsEnabled="{Binding FlagArcLineJunctions}">
                        <TextBlock Text="Arc–Line Angle (deg): " Style="{DynamicResource SecondaryTextStyle}" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding ArcLineAngleToleranceDegrees, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ThemeAwareTextBoxStyle}" Width="70" Height="22"/>
                    </StackPanel>
                    <CheckBox Content="Show Warnings on Map" IsChecked="{Binding ShowWarningsOnMap}" 
                              ToolTip="Controls whether WARNING-level issues (such as arc–line junctions) are rendered as map overlay graphics." 
                              Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,2"/>
                </StackPanel>

                <!-- 10. Missing Junction Vertices -->
                <CheckBox Content="10. Missing Junction Vertices" IsChecked="{Binding CheckMissingJunctions}" Margin="0,4,0,2" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="20,0,0,4">
                    <TextBlock Text="Tolerance (cm): " Style="{DynamicResource SecondaryTextStyle}" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding MissingJunctionToleranceCm, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search tolerance in centimeters (Default: 10 cm. E.g. 10 cm = 0.10 m)" Style="{DynamicResource ThemeAwareTextBoxStyle}" Width="70" Height="22"/>
                </StackPanel>

                <!-- 11. Flat / Pseudo-Arcs -->
                <CheckBox Content="11. Flat / Pseudo-Arcs" IsChecked="{Binding CheckFlatPseudoArcs}" Margin="0,4,0,2" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="20,0,0,2" IsEnabled="{Binding CheckFlatPseudoArcs}">
                    <TextBlock Text="Max Sagitta (cm): " Style="{DynamicResource SecondaryTextStyle}" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding FlatArcSagittaToleranceCm, UpdateSourceTrigger=PropertyChanged}" ToolTip="Maximum sagitta / arc height in cm (Default: 0.01 cm = 0.1 mm)" Style="{DynamicResource ThemeAwareTextBoxStyle}" Width="70" Height="22"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="20,0,0,4" IsEnabled="{Binding CheckFlatPseudoArcs}">
                    <TextBlock Text="Max Area (sq cm): " Style="{DynamicResource SecondaryTextStyle}" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding FlatArcAreaToleranceCm2, UpdateSourceTrigger=PropertyChanged}" ToolTip="Maximum enclosed circular segment area in sq cm (Default: 10.0 sq cm)" Style="{DynamicResource ThemeAwareTextBoxStyle}" Width="70" Height="22"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource SidebarHeaderBackgroundBrush}" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Button Content="Restore Defaults" Command="{Binding ResetDefaultsCommand}" Style="{DynamicResource BlueActionButtonStyle}" Height="30"/>
        </Border>
    </Grid>
</UserControl>
