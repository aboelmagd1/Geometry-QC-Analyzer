<ArcGIS defaultAssembly="GeometryQCAddIn.dll" defaultNamespace="GeometryQCAddIn" xmlns="http://schemas.esri.com/DADF/Registry" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://schemas.esri.com/DADF/Registry file:///C:/Program%20Files/ArcGIS/Pro/bin/ArcGIS.Desktop.Framework.xsd">
  <AddInInfo id="{8a7f921d-44a3-4b92-95f2-953e5e6080dc}" version="1.0.5" author="Created by Mahmoud Aboelmagd with AI" desktopVersion="3.3">
    <Name>Geometry QC Analyzer</Name>
    <Description>High-performance, read-only Polygon Geometry Quality Control Analyzer for ArcGIS Pro.</Description>
    <Image>Images\AddinDesktop32.png</Image>
    <Author>Created by Mahmoud Aboelmagd with AI</Author>
    <Company>ArcGIS Pro Solutions</Company>
    <Date>2026-09-13</Date>
    <Subject>Geometry Quality Control</Subject>
    <Targets>
      <Target name="ArcGISPro" version="3.3" />
    </Targets>
  </AddInInfo>

  <modules>
    <insertModule id="GeometryQC_Module" className="GeometryQCModule" autoLoad="false" caption="Geometry QC Module">

      <!-- Controls -->
      <controls>
        <button id="GeometryQC_ToggleBtn" caption="Enable QC" className="UI.ToggleQCButton" loadOnClick="true"
                smallImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/GenericCheckMark16.png"
                largeImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/GenericCheckMark32.png">
          <tooltip heading="Toggle Geometry QC">Enable or disable geometry quality control analysis.<disabledText /></tooltip>
        </button>

        <button id="GeometryQC_RunBtn" caption="Run QC" className="UI.RunQCButton" loadOnClick="true"
                smallImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/GenericRun16.png"
                largeImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/GenericRun32.png">
          <tooltip heading="Run Geometry QC">Analyze selected polygon features within current map extent for geometric issues.<disabledText /></tooltip>
        </button>

        <button id="GeometryQC_ResultsBtn" caption="Results" className="UI.ResultsButton" loadOnClick="true"
                smallImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/TableOpen16.png"
                largeImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/TableOpen32.png">
          <tooltip heading="Results Panel">Open the Geometry QC Results DockPane.<disabledText /></tooltip>
        </button>

        <button id="GeometryQC_SettingsBtn" caption="Settings" className="UI.SettingsButton" loadOnClick="true"
                smallImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/GenericOptions16.png"
                largeImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/GenericOptions32.png">
          <tooltip heading="QC Settings">Configure geometry check tolerances and trigger modes.<disabledText /></tooltip>
        </button>

        <button id="GeometryQC_ClearBtn" caption="Clear Results" className="UI.ClearResultsButton" loadOnClick="true"
                smallImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/GenericEraser16.png"
                largeImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/GenericDeleteRed32.png">
          <tooltip heading="Clear Results">Clear detected issues and remove temporary map graphics.<disabledText /></tooltip>
        </button>

        <button id="GeometryQC_CancelBtn" caption="Cancel" className="UI.CancelQCButton" loadOnClick="true"
                smallImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/GenericStop16.png"
                largeImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/GenericStop32.png">
          <tooltip heading="Cancel QC Run">Halt active quality control execution.<disabledText /></tooltip>
        </button>
      </controls>

      <!-- DockPanes -->
      <dockPanes>
        <dockPane id="GeometryQC_ResultsDockPane" caption="Geometry QC Results"
                  className="UI.ResultsDockPaneViewModel"
                  dock="right">
          <content className="UI.ResultsDockPaneView" />
        </dockPane>

        <dockPane id="GeometryQC_SettingsDockPane" caption="Geometry QC Settings"
                  className="UI.SettingsDockPaneViewModel"
                  dock="right">
          <content className="UI.SettingsDockPaneView" />
        </dockPane>
      </dockPanes>

      <!-- Ribbon Groups -->
      <groups>
        <group id="GeometryQC_MainGroup" caption="Validation" appearsOnAddInTab="false">
          <button refID="GeometryQC_ToggleBtn" size="large" />
          <button refID="GeometryQC_RunBtn" size="large" />
          <button refID="GeometryQC_ClearBtn" size="middle" />
          <button refID="GeometryQC_CancelBtn" size="middle" />
        </group>
        <group id="GeometryQC_PanelsGroup" caption="Panels" appearsOnAddInTab="false">
          <button refID="GeometryQC_ResultsBtn" size="large" />
          <button refID="GeometryQC_SettingsBtn" size="large" />
        </group>
      </groups>

      <!-- Ribbon Tabs -->
      <tabs>
        <tab id="GeometryQC_Tab" caption="Geometry QC">
          <group refID="GeometryQC_MainGroup" />
          <group refID="GeometryQC_PanelsGroup" />
        </tab>
      </tabs>

    </insertModule>
  </modules>
</ArcGIS>
